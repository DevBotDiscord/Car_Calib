# Raspberry Pi control-direct runtime. pigpio uses BCM pin numbers.
# Remote deploy target. Leave RPI_PASSWORD blank to use SSH key auth.
RPI_HOST=100.118.87.41
RPI_USER=root
RPI_PORT=22
RPI_PASSWORD=11
RPI_DEST_DIR=/opt/car-calib-control-direct

CONTROL_HARDWARE=pigpio
MAIN_CAMERA_INDEX=0
MAIN_TARGET_HZ=30
MAIN_CSV_LOG_FILE=/data/logs/control_direct_run.csv

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

PIGPIO_HOST=127.0.0.1
PIGPIO_PORT=8888
START_PIGPIOD=true

# Servo MG995R on PWM-capable BCM12.
SERVO_PIN=12
SERVO_CENTER_ANGLE=-35
MAX_STEERING_OFFSET=60
DRIVER_SERVO_ANGLE_MIN=-90
DRIVER_SERVO_ANGLE_MAX=90
DRIVER_SERVO_PULSE_MIN_US=500
DRIVER_SERVO_PULSE_MAX_US=2500

# Base 3-bit control, BCM pins. Map matches legacy ESP/RPi convention.
BASE_OUT1=17
BASE_OUT2=27
BASE_OUT3=22

# Relay + power pulse, BCM pins.
RELAY_PIN=13
POWER_RELAY_PIN=5
RELAY_ACTIVE_LOW=false
POWER_RELAY_ACTIVE_LOW=false
POWER_ON_PULSE_MS=100
POWER_OFF_PULSE_MS=3000

ROUTE_SCRIPT_REPUBLISH_HZ=10
ROUTE_LOG_ROOT=/data/routes
