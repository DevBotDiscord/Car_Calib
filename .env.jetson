# ========================================================================== #
# Jetson Nano direct calibration — mirror of .env.production values
# ========================================================================== #
# Copy to .env, adjust GPIO pins for your wiring, then:
#   ./deploy_jetson.sh
# ========================================================================== #

# --- Main loop ---
MAIN_TARGET_HZ=30
MAIN_CAMERA_INDEX=2
MAIN_CSV_LOG_FILE=run_log.csv
MAIN_FLIP_FRAME=false
MAIN_TERMINAL_LOG=true
MAIN_DEBUG_MODE=true
MAIN_SHOW_DETECTOR_DEBUG=true
MAIN_FRAME_WIDTH=640
MAIN_FRAME_HEIGHT=480

# --- Servo (PWM via Jetson.GPIO, BOARD numbering) ---
# MG995R: [-90..+90] deg → [1000..2000] µs pulse
DRIVER_SERVO_ANGLE_MIN=-90
DRIVER_SERVO_ANGLE_MAX=90
DRIVER_SERVO_PULSE_MIN_US=1000
DRIVER_SERVO_PULSE_MAX_US=2000
SERVO_CENTER_ANGLE=-35
MAX_STEERING_OFFSET=60.0
SERVO_PIN=33          # BOARD pin 33 (PWM-capable)

# --- Base motor (3-bit GPIO, BOARD numbering) ---
BASE_BIT2_PIN=15      # bit2 (high) – maps to RPi BCM14/OUT1
BASE_BIT1_PIN=13      # bit1 (mid)  – maps to RPi BCM12/OUT2 (check wiring!)
BASE_BIT0_PIN=11      # bit0 (low)  – maps to RPi BCM13/OUT3 (check wiring!)

# --- Relay + ignition power (BOARD numbering) ---
RELAY_PIN=18          # relay ON/OFF toggle
POWER_PIN=16          # ignition power pulse (100ms ON, 3000ms OFF)
RELAY_ACTIVE_LOW=true
POWER_RELAY_ACTIVE_LOW=true
POWER_ON_PULSE_MS=100
POWER_OFF_PULSE_MS=3000

# --- Vision detector ---
ROI_HEIGHT_PCT=0.6
ROI_TOP_WIDTH_PCT=0.75
ROI_BOTTOM_WIDTH_PCT=1.0
ROBOT_DEBUG_MODE=false
VISION_CLAHE_CLIP_LIMIT=2.0
VISION_CLAHE_TILE_GRID_W=8
VISION_CLAHE_TILE_GRID_H=8
VISION_BLUR_KERNEL_W=5
VISION_BLUR_KERNEL_H=5
VISION_CANNY_LOW=50
VISION_CANNY_HIGH=150
VISION_HOUGH_THRESHOLD=40
VISION_HOUGH_MIN_LINE_LENGTH=40
VISION_HOUGH_MAX_LINE_GAP=20
VISION_MIN_ABS_SLOPE=0.3
VISION_CLUSTER_ANGLE_DEG=7.5
VISION_CLUSTER_DIST_PX=30.0
VISION_MIN_GROUP_TOTAL_LENGTH_PX=100.0

# --- Steering controller ---
VP_INNER_THRESH=3.0
VP_OUTER_THRESH=8.0
DANGER_MARGIN_PX=130
DANGER_NUDGE_DEG=10.0
CTRL_HYSTERESIS_HIGH=5.0
CTRL_HYSTERESIS_LOW=3.0
PID_KP=0.9
PID_KD=0.08
PID_CALIBRATION_CLEAR_TOLERANCE_DEG=1.0

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
