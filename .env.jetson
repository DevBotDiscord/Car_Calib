# Jetson Nano direct calibration — copy to .env and adjust

# Camera
MAIN_CAMERA_INDEX=0
MAIN_TARGET_HZ=30

# Servo (PWM pin — BOARD numbering)
SERVO_PIN=33
SERVO_CENTER_ANGLE=-35
MAX_STEERING_OFFSET=60
DRIVER_SERVO_ANGLE_MIN=-90
DRIVER_SERVO_ANGLE_MAX=90
DRIVER_SERVO_PULSE_MIN_US=1000
DRIVER_SERVO_PULSE_MAX_US=2000

# Base motor (3-bit GPIO — BOARD numbering)
BASE_BIT2_PIN=15
BASE_BIT1_PIN=13
BASE_BIT0_PIN=11

# Relay + ignition power
RELAY_PIN=18
POWER_PIN=16

# Vision
VISION_CANNY_LOW=50
VISION_CANNY_HIGH=150
VISION_HOUGH_THRESHOLD=50
VISION_HOUGH_MIN_LINE_LEN=30
VISION_MIN_ABS_SLOPE=0.3
VISION_ANGLE_THRESHOLD_DEG=5.0

# Steering
VP_INNER_THRESH=3.0
VP_OUTER_THRESH=5.0
DANGER_MARGIN_PX=100
DANGER_NUDGE_DEG=5.0
CTRL_HYSTERESIS_HIGH=5.0
CTRL_HYSTERESIS_LOW=3.0

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
